# OpenRouter API
OPENROUTER_API_KEY=dein_openrouter_api_key_hier
# Text- und Vision-Modell (OpenRouter model string)
MODEL=google/gemini-3.8-flash
# Bildmodell (für generate_product_shot etc.)
IMAGE_MODEL=google/gemini-nano-banana-2.1

# Datenbank (lokal SQLite; auf Railway Postgres via DATABASE_URL)
DATABASE_URL=sqlite:///./vesti.db

# Auth (JWT). Sicheres Secret erzeugen: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=43200

# CORS: URL des Frontends, kommagetrennt (oder * fuer alle)
CORS_ORIGINS=*
