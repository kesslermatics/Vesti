# Gemini API
GEMINI_API_KEY=dein_api_key_hier
GEMINI_MODEL=gemini-3.5-flash-lite
# Bildgenerierung (Nano Banana) fuer KI-Produktfotos
# Preview-Modell umgeht den EU-Geoblocking-Mechanismus der GA-Version
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Datenbank (lokal SQLite; auf Railway Postgres via DATABASE_URL)
DATABASE_URL=sqlite:///./vesti.db

# Auth (JWT). Sicheres Secret erzeugen: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=43200

# CORS: URL des Frontends, kommagetrennt (oder * fuer alle)
CORS_ORIGINS=*
