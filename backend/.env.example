# OpenRouter API
OPENROUTER_API_KEY=dein_openrouter_api_key_hier
# Text- und Vision-Modell (OpenRouter model string)
MODEL=google/gemini-3.8-flash
# Bildmodell (für generate_product_shot etc.)
IMAGE_MODEL=google/gemini-nano-banana-2.1

# Datenbank: lokal SQLite; in Produktion (Dokploy) die interne Postgres-URL:
# postgresql://<user>:<passwort>@<postgres-appName>:5432/<db>
DATABASE_URL=sqlite:///./vesti.db

# Auth (JWT). Sicheres Secret erzeugen: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In Produktion den bisherigen Wert beibehalten, sonst müssen sich alle Nutzer neu anmelden.
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=43200

# CORS: URL des Frontends, kommagetrennt (oder * fuer alle)
CORS_ORIGINS=*

# Port im Container (Dokploy-Domain zeigt auf diesen Port)
PORT=8000

# Bildspeicher: S3-kompatibel (Cloudflare R2). Ohne diese Werte landen Bilder in der DB.
S3_ENDPOINT_URL=https://<account-id>.eu.r2.cloudflarestorage.com
S3_BUCKET=dein_bucket
S3_REGION=auto
S3_KEY_PREFIX=Vesti/
S3_ACCESS_KEY_ID=dein_access_key
S3_SECRET_ACCESS_KEY=dein_secret_key
