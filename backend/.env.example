# OpenAI API
OPENAI_API_KEY=dein_api_key_hier
# Muss ein in deinem OpenAI-Projekt freigeschaltetes Modell sein.
OPENAI_MODEL=gpt-6-sol
# Bildgenerierung und Bildbearbeitung für KI-Produktfotos und Try-ons.
OPENAI_IMAGE_MODEL=gpt-image-1

# Datenbank (lokal SQLite; auf Railway Postgres via DATABASE_URL)
DATABASE_URL=sqlite:///./vesti.db

# Auth (JWT). Sicheres Secret erzeugen: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=43200

# CORS: URL des Frontends, kommagetrennt (oder * fuer alle)
CORS_ORIGINS=*
